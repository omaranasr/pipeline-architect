# Copy to .env.local for local development, and set the same VITE_* variables in
# Cloudflare Pages → Settings → Environment variables for production builds.
#
# These are Firebase *web* configuration values. They identify your Firebase project and are
# embedded in the JavaScript bundle by design; they are not secrets. Access control is enforced
# by Firebase Authentication + firestore.rules. NEVER put service-account keys, private keys or
# admin credentials in VITE_* variables — everything prefixed VITE_ is public.
#
# Find them in Firebase console → Project settings → General → Your apps → Web app → SDK setup.

VITE_FIREBASE_API_KEY=
VITE_FIREBASE_AUTH_DOMAIN=your-project-id.firebaseapp.com
VITE_FIREBASE_PROJECT_ID=your-project-id
VITE_FIREBASE_APP_ID=

# Local development against the Firebase Emulator Suite (no real project needed; requires Java).
# Start the emulators with `npm run dev:emulators`, then set this to true.
VITE_USE_FIREBASE_EMULATORS=false
